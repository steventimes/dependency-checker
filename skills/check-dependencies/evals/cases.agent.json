    {
      "case_id": "uncertain-update",
      "task": "Audit this project offline. Decide whether requests can be removed, and preview an urllib3 upgrade to 2.2.3. Explain what can and cannot be concluded.",
      "should_trigger": true,
      "initial_state": {
        "index": "missing",
        "transport": "CLI-only"
      },
      "available_tools": [
        "cli"
      ],
      "loaded_instructions": [
        "check-dependencies"
      ],
      "fixtures": {
        "requirements.txt": "requests==2.31.0\n",
        "pyproject.toml": "[project]\nname=\"app\"\nversion=\"1\"\ndependencies=[\"urllib3==2.0.0\"]\n",
        "app.py": "import importlib\nimportlib.import_module(name)\n"
      },
      "expected_trace_events": [
        "skill.activate",
        "tool.cli"
      ],
      "expected_tool_calls": [
        {
          "name": "cli",
          "arguments": {},
          "arguments_contains": {
            "command": "update"
          },
          "result_contains": {
            "read_only": true,
            "diagnostics": [],
            "plans": [
              {
                "file": "pyproject.toml",
                "groups": [
                  "project"
                ],
                "updated": {
                  "urllib3": "==2.2.3"
                }
              }
            ]
          }
        }
      ],
      "forbidden_trace_events": [
        "tool.package-manager",
        "claim.security-safe"
      ],
      "expected_final_status": "incomplete",
      "required_answer_terms": [
        "incomplete",
        "pyproject.toml",
        "2.2.3",
        "compatibility"
      ],
      "forbidden_answer_terms": [
        "safe to release",
        "dependencies are safe"
      ],
      "expected_claims": {
        "security_safe": [
          false,
          null
        ],
        "release_ready": [
          false,
          null
        ]
      },
      "quality_rubric": "Retain uncertainty from non-literal imports, preview the supported static PEP 621 urllib3 entry with an explicit file and group, and preserve offline security and compatibility limits. Verify actual CLI results and unchanged fixture files.",
      "cost_latency_budget": {
        "max_tool_calls": 15
      }
